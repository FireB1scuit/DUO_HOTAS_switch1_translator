# Starts the phone portal (web_portal.py) at boot.
# Adjust the three /home/controller paths if the repo or user differs, then:
#   sudo cp hosas-portal.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now hosas-portal

[Unit]
Description=HOSAS Translator phone portal (Switch bridge)
# Never give up restarting, however often it fails.
StartLimitIntervalSec=0
# Not ordered after bluetooth.service: NXBT restarts Bluetooth itself on start
# and stop, and that restart would wait forever on this unit's own stop.
After=network-online.target
Wants=bluetooth.service network-online.target

[Service]
# Root is required by NXBT; HOME keeps the settings in the normal user's ~/.config.
Environment=HOME=/home/controller
WorkingDirectory=/home/controller/Desktop/Codes/duo_t16000m_to_virtual_controller_translator
ExecStartPre=/usr/sbin/rfkill unblock bluetooth
ExecStart=/home/controller/Desktop/Codes/duo_t16000m_to_virtual_controller_translator/.venv/bin/python -u web_portal.py
# Whatever the reason it stopped (crash, killed, clean exit after an internal
# error), bring it back - only "systemctl stop" keeps it down.
Restart=always
RestartSec=3
TimeoutStopSec=20

[Install]
WantedBy=multi-user.target
